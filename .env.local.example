# ======================================================
# CopyPasta Environment Variables
# ======================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ======================================================

# Supabase Project URL (found in: Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon (public) key — safe to expose in frontend
# (found in: Project Settings > API > Project API keys > anon/public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# =====================================================
# DO NOT add SUPABASE_SERVICE_ROLE_KEY here.
# The service role key bypasses RLS and must NEVER
# be exposed in frontend code or committed to git.
# If you ever need it for server-only migrations,
# add it as a server-only env var (no NEXT_PUBLIC_ prefix).
# =====================================================
